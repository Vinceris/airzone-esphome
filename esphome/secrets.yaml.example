# Copy to secrets.yaml (same folder as airzone.yaml) and fill in your values.
# secrets.yaml is git-ignored.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"
ap_password: "fallback-hotspot-password"
# 32-byte base64 key, e.g. from https://esphome.io/components/api.html
api_key: "REPLACE_WITH_BASE64_KEY"
ota_password: "your-ota-password"
